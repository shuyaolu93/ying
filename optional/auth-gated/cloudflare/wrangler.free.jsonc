{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ronghe-risk-free",
  "main": "free-worker.js",
  "compatibility_date": "2026-10-18",
  "ratelimits": [
    { "name": "AUTH_IP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_ACCOUNT_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ronghe-db",
      "database_id": "7a75c638-9544-48c0-9ff5-778888884dfa"
    }
  ]
}
